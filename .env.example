# RasheedhaMart Environment Variable Configuration

# Server Port
PORT=8080

# Database Configuration (MySQL / H2 Fallback)
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://localhost:3306/rasheedhamart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=rootpassword

# HikariCP Connection Pool Settings
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000

# AI Chatbot Configuration
AI_CHATBOT_PROVIDER=mock # Options: mock | gemini
AI_API_KEY=your_gemini_api_key_here

# JWT / Session Secrets
SESSION_SECRET=rasheedhamart_secret_key_2026
